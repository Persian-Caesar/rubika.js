{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "types": [
            "@types/node"
        ],
        "strict": true,
        "declaration": true,
        "skipLibCheck": true,
        "inlineSourceMap": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "tests"
    ]
}
